import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long num=sc.nextLong();
        long snum=num*num;
        long rev1=0;
        while(num!=0){
            long rem=num%10;
            rev1=rev1*10+rem;
            num/=10;
            
        }
        long srev=rev1*rev1;
        long rev2=0;
        while(srev!=0){
            long rem=srev%10;
            rev2=rev2*10+rem;
            srev/=10;
            
        }
        if(snum==rev2){
            System.out.print("Yes");
        }
        else{
            System.out.print("No");
        }
    }
}
