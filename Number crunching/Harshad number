import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        long orgn=n;
        long sum=0;
        while(n!=0){
            long rem=n%10;
            sum+=rem;
            n/=10;
        }
        if(orgn%sum==0){
            System.out.print("Yes");
        }
        else{
            System.out.print("No");
        }
    }
}
