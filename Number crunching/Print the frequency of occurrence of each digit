import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long num=sc.nextLong();
        
        for(long i=0;i<=9;i++){
            long count=0;
            long temp=num;
            while(temp!=0){
                long rem=temp%10;
                if(rem==i){
                    count++;
                
                    
                }
                temp/=10;
                
            }
            System.out.println(i+" : "+count);
            
        }
        
    }
    
}
