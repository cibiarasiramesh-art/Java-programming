import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long num=sc.nextLong();
        long target=sc.nextLong();
        long count=0;
        while(num!=0){
            long rem=num%10;
            if(rem==target){
                count++;
            }
            num/=10;
        }
        System.out.print(count);
    }
}
