import java.util.*;
public class main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        long count=0;
        while(n!=0){
            long rem=n%10;
            if(rem%2==0){
                count++;
            }
            n/=10;
        }
        System.out.print(count);
    }
}
