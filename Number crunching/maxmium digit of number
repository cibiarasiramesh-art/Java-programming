import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        long max=0;
        while(n!=0){
            long rem=n%10;
            if(rem>max){
                max=rem;
            }
            n/=10;
        }
        System.out.print(max);
    }
}
