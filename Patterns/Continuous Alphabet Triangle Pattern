import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        int val=65;
        for(long i=1;i<=n;i++){
            for(long j=1;j<=i;j++){
                System.out.printf("%c",val);
                val++;
            }
            System.out.println();
        }
    }
}
