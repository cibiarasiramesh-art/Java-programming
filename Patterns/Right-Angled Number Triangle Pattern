import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        long dj=1;
        for(long i=n;i>=1;i--){
            for(long j=dj;j<=n;j++){
                System.out.print(j);
                
            }
            dj++;
            System.out.println();
        }
    }
}
