import java.util.*;
public class Inverted_Diamond {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int space  = n*2-1;
        for(int i=0;i<n;i++){
            for(int j=1;j<=i;j++){
                System.out.print("&");
            }
            for(int j=space;j>0;j--){
                System.out.print("*");
            }
            space-=2;
            System.out.println();
        }

    }
    
}
