import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        long product=1;
        long sum=0;
        for(long i=1;i<=n;i++){
            product*=i;
            sum+=i;
            
        }
        if(product%sum==0){
            System.out.print("Yes");
        }
        else{
            System.out.print("No");
        }
    }
}
