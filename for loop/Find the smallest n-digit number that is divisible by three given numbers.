import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        long n=sc.nextLong();
        long n1=sc.nextLong();
        long n2=sc.nextLong();
        long n3=sc.nextLong();
        long start=(long)Math.pow(10,n-1);
        long end=(long)Math.pow(10,n);
        for(long i=start;i<=end;i++){
            if(i%n1==0 && i%n2==0 && i%n3==0){
                System.out.print(i);
                break;
                
            }
        }
    
    }
}
